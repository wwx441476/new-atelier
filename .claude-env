# 项目环境配置（由 Claude 使用）
# source 此文件可统一项目环境变量

# Java 8（项目依赖，Java 21 会导致 aspose-license 模块访问失败）
export JAVA_HOME=/Library/Java/JavaVirtualMachines/jdk1.8.0_201.jdk/Contents/Home
export PATH=$JAVA_HOME/bin:$PATH

# Maven 3.6.1
export MAVEN_HOME=/Users/wangshunxi/apache-maven-3.6.1
export PATH=$MAVEN_HOME/bin:$PATH

# 私有 Maven 仓库
export MAVEN_OPTS="-Dmaven.repo.local=/Volumes/S/repository"
