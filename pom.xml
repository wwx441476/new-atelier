<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.example.atelier</groupId>
    <artifactId>new-atelier</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>new-atelier</name>
    <description>数据工场重构版 — 低耦合、声明式指标</description>

    <modules>
        <module>atelier-domain</module>
        <module>atelier-metrics</module>
        <module>atelier-query</module>
        <module>atelier-infra</module>
        <module>atelier-metadata</module>
        <module>atelier-dimension</module>
        <module>atelier-warning</module>
        <module>atelier-api</module>
        <module>atelier-app</module>
    </modules>

    <properties>
        <java.version>1.8</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <spring-boot.version>2.7.12</spring-boot.version>
        <maven.compiler.source>1.8</maven.compiler.source>
        <maven.compiler.target>1.8</maven.compiler.target>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>com.example.atelier</groupId>
                <artifactId>atelier-domain</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.example.atelier</groupId>
                <artifactId>atelier-metrics</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.example.atelier</groupId>
                <artifactId>atelier-query</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.example.atelier</groupId>
                <artifactId>atelier-infra</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.example.atelier</groupId>
                <artifactId>atelier-metadata</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.example.atelier</groupId>
                <artifactId>atelier-dimension</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.example.atelier</groupId>
                <artifactId>atelier-warning</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.example.atelier</groupId>
                <artifactId>atelier-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.projectlombok</groupId>
                <artifactId>lombok</artifactId>
                <version>1.18.30</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.11.0</version>
                    <configuration>
                        <source>${java.version}</source>
                        <target>${java.version}</target>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
